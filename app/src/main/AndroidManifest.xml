<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Obrigatório para a captura de áudio interno (AudioPlaybackCapture). -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Vibração curta como confirmação ao iniciar/parar a gravação. -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Serviço em primeiro plano para manter a gravação ativa em background. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <!-- Notificação persistente com o cronômetro da gravação (Android 13+). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:theme="@style/Theme.Zrec"
        android:supportsRtl="true"
        android:allowBackup="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Serviço de gravação. Roda em primeiro plano tipando como mediaProjection. -->
        <service
            android:name=".RecordingService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />
    </application>
</manifest>
